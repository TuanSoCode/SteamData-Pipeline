      "source": [
        "mask=df[\"Website\"].notna() & ~df[\"Website\"].str.contains(r'\\.',na=False)\n",
        "df.loc[mask, \"Website\"]=None\n",
        "mask_kiem=df[\"Website\"].notna() & ~df[\"Website\"].str.contains(r'\\.',na=False)\n",
        "print(mask_kiem.sum())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "mkC6CJ8SDyXt"
      },
      "outputs": [],
      "source": [
        "df=df.drop(columns={\"Movies\",\"Score rank\",\"Metacritic url\",\"Reviews\"})"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "FUPVzTZ3UXA3"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "for col in [\"Full audio languages\",\"Supported languages\"]:\n",
        "\n",
        "    df[col] = df[col].apply(\n",
        "    lambda x: \", \".join(x) if isinstance(x, list)\n",
        "    else (x if pd.isna(x) else str(x).replace('[', '').replace(']', '').replace(\"'\",\"\").strip())\n",
        ")\n",
        "df=df.replace('',np.nan)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "reIL-yhKfpZA"
      },
      "outputs": [],
      "source": [
        "def fill(df,rule):\n",
        "   for f in df.columns:\n",
        "      if f in rule:\n",
        "        df[f]=df[f].fillna(rule[f])\n",
        "      else:\n",
        "        df[f]=df[f].fillna(\"Unknown\")\n",
        "   return df\n",
        "\n",
        "rule={\"Notes\":\"Not provided\"}\n",
        "df=fill(df,rule)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Y6u6BH8pfGi3"
      },
      "outputs": [],
      "source": [
        "def save(df,unique_limit=255):\n",
        "   for f in df.columns:\n",
        "      if df[f].dtype== \"bool\":\n",
        "        continue\n",
        "      if df[f].dtype== \"int64\" and df[f].min() >=0 and df[f].max() <= 255:\n",
        "         df[f]=df[f].astype(\"uint8\")\n",
        "      elif df[f].nunique() <= unique_limit:df[f]=df[f].astype(\"category\")\n",
        "   return df\n",
        "df=save(df)"
      ]
    },
