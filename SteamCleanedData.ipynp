    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "FdcnBjL9a6r3"
      },
      "outputs": [],
      "source": [
        "!pip install xlsxwriter openpyxl\n",
        "import importlib\n",
        "from csv_helper import export_styled_excel,export_files\n",
        "\n",
        "df['Primary Genre'] = df['Genres'].apply(lambda x: str(x).split(',')[0])\n",
        "df_genre = df.groupby('Primary Genre')['Price'].mean().reset_index()\n",
        "df_genre.columns = ['Genre', 'Avg Price ($)']\n",
        "df_genre['Avg Price ($)'] = df_genre['Avg Price ($)'].round(2)\n",
        "df_genre = df_genre.sort_values(by='Avg Price ($)', ascending=False).head(10)\n",
        "\n",
        "export_styled_excel(df_genre, \"/content/drive/MyDrive/Steam_Report\")\n",
        "export_files(df, \"/content/drive/MyDrive/Steam_FullData\")"
      ]
    }
  ],
  "metadata": {
