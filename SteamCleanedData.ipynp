    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Cg6XWorNCkTV"
      },
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import kagglehub\n",
        "# Download latest version\n",
        "path = kagglehub.dataset_download(\"fronkongames/steam-games-dataset\")\n",
        "import os\n",
        "print(os.listdir(path))\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "import sys\n",
        "sys.path.append('/content/drive/MyDrive')\n",
        "from csv_helper import ba_khi,ba_dao,export_styled_excel\n",
        "\n",
        "df= ba_khi(path+ \"/games.csv\")\n",
        "df = ba_dao(path + \"/games.csv\", \"DiscountDLC count\", [\"Discount\", \"DLC count\"])\n",
        "!pip install pandera\n",
        "import pandera.pandas as pa\n",
        "from pandera import Column,Check\n",
        "from pandera.errors import SchemaErrors\n",
        "schema=pa.DataFrameSchema({\n",
        "\"AppID\":Column(int, unique=True,nullable=False),\n",
        "\"Name\":Column(str,nullable=False),\n",
        "\"Price\":Column(float,Check.greater_than_or_equal_to(0)),\n",
        "\"Developers\":Column(str,nullable=True),\n",
        "\"Publishers\":Column(str,nullable=True),\n",
        "\"Required age\":Column(int,Check.in_range(0,21)),\n",
        "\"Website\": pa.Column(str, pa.Check.str_contains(r'\\.'), nullable=True),\n",
        "})\n",
        "\n",
        "\n",
        "\n",
        "try:\n",
        "    schema.validate(df,lazy=True)\n",
        "    print(\"✅✅✅✅✅🤑🤑🤑🤑\")\n",
        "except SchemaErrors as loi:\n",
        "    bang_loi = loi.failure_cases\n",
        "    print(\"Có\", len(bang_loi), \"chỗ vi phạm\")\n",
        "    print(bang_loi.groupby([\"column\", \"check\"]).size())\n",
        "    display(bang_loi.head(10))"
      ]
    },
